# Version Management (선택 — 생략 시 latest)
# CI/CD가 latest 태그로 배포하므로 평소에는 불필요.
# 롤백 시에만 서버 .env에서 특정 태그(sha-<커밋해시>)로 고정하고 deploy:update 실행.
# FRONTEND_VERSION=latest
# BACKEND_VERSION=latest

# Database
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=dngg
DB_HOST=db
DB_PORT=5432
PORT=3010

# API
NEXT_PUBLIC_API_URL=http://localhost:3010

# Auth
JWT_SECRET=your_jwt_secret_here
