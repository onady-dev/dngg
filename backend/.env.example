# backend 로컬 개발용 env 템플릿
# 사용법: 이 파일을 .env.dev 로 복사하고 값을 채운다 (pnpm dev가 로드).
#   - docker-compose.dev.yml로 컨테이너 실행 시에는 .env.development 로 복사하고 DB_HOST=db 로 변경.
#   - 운영(.env.prod)은 서버의 /usr/local/project/dngg/.env에서 컨테이너로 주입되므로 로컬에 불필요.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here   # 루트 .env의 DB_PASSWORD와 동일하게
DB_DATABASE=dngg
PORT=3010
JWT_SECRET=your_jwt_secret_here  # 로컬용 — 운영 값과 달라도 됨

# 토스페이먼츠 시크릿 키 (서버 전용 — 절대 프론트 노출 금지)
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxx
# 구독 가격 (원) — 기존 구독자의 다음 갱신 금액도 이 값으로 청구됨
SUBSCRIPTION_PRICE_MONTHLY=9900
SUBSCRIPTION_PRICE_YEARLY=99000
# 무료 그룹 경기 생성 한도
FREE_GAME_LIMIT=10
# 토스 웹훅 서명 검증용 보안키 (Phase 2 웹훅 구현 시 사용 — 개발자센터 웹훅 설정에서 발급)
TOSS_WEBHOOK_SECRET=
