# backend 로컬 개발용 env 템플릿
# 사용법: 이 파일을 .env.dev 로 복사하고 값을 채운다 (pnpm dev가 로드).
#   - docker-compose.dev.yml로 컨테이너 실행 시에는 .env.development 로 복사하고 DB_HOST=db 로 변경.
#   - 운영(.env.prod)은 서버의 /usr/local/project/dngg/.env에서 컨테이너로 주입되므로 로컬에 불필요.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here   # 루트 .env의 DB_PASSWORD와 동일하게
DB_DATABASE=dngg
PORT=3010
JWT_SECRET=your_jwt_secret_here  # 로컬용 — 운영 값과 달라도 됨
