# frontend 로컬 개발용 env 템플릿
# 사용법: 이 파일을 .env.development 로 복사한다 (next dev가 로드).
# NEXT_PUBLIC_* 값은 빌드 시점에 번들에 박힌다. 운영 이미지는 CI가 build-arg로 주입하므로
# .env.production은 로컬에서 운영 이미지를 수동 빌드할 때만 필요하다.

NEXT_PUBLIC_API_URL=http://localhost:3010

# 토스페이먼츠 클라이언트 키 (빌드 시점에 박힘 — 변경 시 이미지 재빌드 필요)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxx
